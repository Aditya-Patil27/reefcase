# ReefCase environment. Copy to `.env` and fill in; every value is read through
# `reefcase.core.config.Settings` (prefix `REEFCASE_`). Never commit `.env`.

# storage
REEFCASE_DATA_DIR=

# segmentation
REEFCASE_SEGMENTER=
REEFCASE_SAM_MODEL_ID=
REEFCASE_SAM_MODAL_URL=
REEFCASE_SAM_MODAL_TOKEN=
REEFCASE_STUDENT_WEIGHTS=

# LLM roles (OpenAI-compatible endpoints)
REEFCASE_LLM_AGENT_BASE_URL=https://inference.baseten.co/v1
REEFCASE_LLM_AGENT_API_KEY=
REEFCASE_LLM_AGENT_MODEL=meta-models/muse-spark-open-1026
REEFCASE_LLM_TEACHER_BASE_URL=https://inference.baseten.co/v1
REEFCASE_LLM_TEACHER_API_KEY=
REEFCASE_LLM_TEACHER_MODEL=meta-models/muse-spark-open-1026
REEFCASE_LLM_STUDENT_BASE_URL=
REEFCASE_LLM_STUDENT_API_KEY=
REEFCASE_LLM_STUDENT_MODEL=
REEFCASE_LLM_AGENT_REASONING_EFFORT=medium
REEFCASE_LLM_TEACHER_REASONING_EFFORT=low

# external data sources
REEFCASE_GFW_TOKEN=

# bot
REEFCASE_TELEGRAM_TOKEN=

# pipeline limits
REEFCASE_KEEP_FRAMES=
REEFCASE_MIN_FRAMES=
