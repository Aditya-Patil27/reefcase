# ReefCase environment. Copy to `.env` and fill in; every value is read through
# `reefcase.core.config.Settings` (prefix `REEFCASE_`). Never commit `.env`.

# storage
REEFCASE_DATA_DIR=
# built web app (pnpm -C web build) served at / by the API; unset serves the API only
REEFCASE_WEB_DIST=

# segmentation
REEFCASE_SEGMENTER=
REEFCASE_SAM_MODEL_ID=
REEFCASE_SAM_MODAL_URL=
REEFCASE_SAM_MODAL_TOKEN=
REEFCASE_STUDENT_WEIGHTS=
REEFCASE_DISAGREEMENT_CHECK=

# LLM roles (OpenAI-compatible endpoints)
# Working Baseten values (5.1 smoke, 2026-10-30): base URL https://inference.baseten.co/v1,
# model meta-models/muse-spark-open-1026 for agent and teacher, reasoning effort
# medium (agent) and low (teacher).
REEFCASE_LLM_AGENT_BASE_URL=
REEFCASE_LLM_AGENT_API_KEY=
REEFCASE_LLM_AGENT_MODEL=
REEFCASE_LLM_TEACHER_BASE_URL=
REEFCASE_LLM_TEACHER_API_KEY=
REEFCASE_LLM_TEACHER_MODEL=
REEFCASE_LLM_STUDENT_BASE_URL=
REEFCASE_LLM_STUDENT_API_KEY=
REEFCASE_LLM_STUDENT_MODEL=
REEFCASE_LLM_AGENT_REASONING_EFFORT=
REEFCASE_LLM_TEACHER_REASONING_EFFORT=

# external data sources
REEFCASE_GFW_TOKEN=

# bot
REEFCASE_TELEGRAM_TOKEN=

# pipeline limits
REEFCASE_KEEP_FRAMES=
REEFCASE_MIN_FRAMES=
